# Environment variables for Vellora Health Platform
DATABASE_URL="file:./dev.db"
NODE_ENV="development"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Notification / SMS Test Mode (Leave empty for development OTP simulator)
SMS_PROVIDER="SIMULATED"
SMS_API_KEY=""

# Payment Gateway Test Mode
PAYMENT_GATEWAY="SIMULATED_TEST"
PAYMENT_KEY_ID="rzp_test_sample_key"
PAYMENT_KEY_SECRET="rzp_test_sample_secret"

# Storage
STORAGE_DRIVER="LOCAL_DISK"
